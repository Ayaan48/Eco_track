# Groq AI service (https://console.groq.com -> API Keys)
GROQ_API_KEY=your_groq_api_key_here

# Carbon Interface API (https://www.carboninterface.com -> Dashboard)
CARBON_INTERFACE_API_KEY=your_carbon_interface_key_here

# Firebase Admin SDK service account (Project Settings -> Service Accounts)
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
